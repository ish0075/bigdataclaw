    },
    {
      "name": "setup_render_pipeline",
      "description": "Configure Remotion rendering",
      "parameters": ["composition_id", "output_format", "quality"],
      "command": "npx remotion render src/index.tsx {{composition_id}} out/{{output_name}}.mp4"
    },
    {
      "name": "generate_animation",
      "description": "Create animated sequences",
      "parameters": ["animation_type", "duration_frames", "easing"],
      "supported_animations": ["fade", "slide", "scale", "rotate", "particle"]
