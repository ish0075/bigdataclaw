  "tools": [
    {
      "name": "export_youtube",
      "description": "16:9 4K version for YouTube",
      "parameters": ["input_file", "quality", "include_subtitles"],
      "ffmpeg_command": "ffmpeg -i {{input}} -vf scale=3840:2160 -c:v libx264 -preset slow -crf 18 -c:a aac -b:a 192k {{output}}",
      "specs": {
        "resolution": "3840x2160 (4K)",
        "aspect_ratio": "16:9",
        "max_duration": "No limit",
        "recommended": "4-10 minutes"
      }
    },
    {
      "name": "export_instagram",
      "description": "9:16 vertical for Instagram Reels",
      "parameters": ["input_file", "max_duration", "add_captions"],
      "ffmpeg_command": "ffmpeg -i {{input}} -vf \"scale=1080:1920:force_original_aspect_ratio=decrease,pad=1080:1920:(ow-iw)/2:(oh-ih)/2,setsar=1\" -c:v libx264 -crf 23 -t {{max_duration}} {{output}}",
      "specs": {
        "resolution": "1080x1920",
        "aspect_ratio": "9:16",
        "max_duration": "90 seconds",
        "max_file_size": "4GB"
      }
    },
    {
      "name": "export_linkedin",
      "description": "1:1 square for LinkedIn",
      "parameters": ["input_file", "max_duration"],
      "ffmpeg_command": "ffmpeg -i {{input}} -vf \"scale=1080:1080:force_original_aspect_ratio=decrease,pad=1080:1080:(ow-iw)/2:(oh-ih)/2\" -c:v libx264 -t {{max_duration}} {{output}}",
      "specs": {
        "resolution": "1080x1080",
        "aspect_ratio": "1:1",
        "max_duration": "10 minutes",
        "max_file_size": "5GB"
      }
    },
    {
      "name": "export_tiktok",
      "description": "9:16 with captions for TikTok",
      "parameters": ["input_file", "trending_audio", "captions"],
      "specs": {
        "resolution": "1080x1920",
        "aspect_ratio": "9:16",
        "max_duration": "10 minutes",
        "format": "MP4 or MOV"
      }
    },
    {
      "name": "schedule_post",
      "description": "Timing optimization",
      "parameters": ["platform", "content", "scheduled_time"],
