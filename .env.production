# BigDataClaw NERVE - Production Environment Variables

# Domain Configuration
DOMAIN=bigdataclaw.com
ACME_EMAIL=admin@bigdataclaw.com

# Redis Configuration
# If you have existing Redis, set the URL here:
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true

# Session Configuration
SESSION_SECRET=change-this-to-a-random-secret-key-in-production
SESSION_TIMEOUT=86400

# API Server Configuration
API_PORT=8000
API_WORKERS=4

# NERVE Frontend Configuration
NERVE_PORT=3001
NODE_ENV=production

# Database (if using PostgreSQL/SQLite backend)
# DATABASE_URL=postgresql://user:password@localhost:5432/bigdataclaw

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-in-production

# Feature Flags
ENABLE_TRACKING=true
ENABLE_EXPORT=true
ENABLE_IMPORT=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# SSL/TLS
SSL_CERT_PATH=/etc/letsencrypt/live/bigdataclaw.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/bigdataclaw.com/privkey.pem
